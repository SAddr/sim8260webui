#!/bin/sh
# Simcom WebUI - Change Password CGI
# 浏览器发 ?action=change&old=<旧密码>&new=<新密码> （通过 POST 更安全，但要解析 POST body）
# 此处用 GET + 请求校验，生产建议改用 POST。先实现基础版本。

# 密码文件
HTPASSWD_FILE="/usrdata/simcom-webui/.htpasswd"
# 默认用户名
USER="admin"

# url 解码（注意：不要 + 转空格，密码可能含 +）
urldecode() { printf '%b' "$(printf '%s' "$1" | sed 's/%\(..\)/\\x\1/g')"; }

# 解析 QUERY_STRING
# set -f：$QUERY_STRING 未加引号展开（靠 IFS='&' 切分），若含 * ? [ 会被 shell
# 当 glob 去匹配当前目录文件，导致参数被篡改。
ACTION=""; OLD_PW=""; NEW_PW=""
if [ -n "$QUERY_STRING" ]; then
    OIFS="$IFS"; IFS='&'; set -f
    for pair in $QUERY_STRING; do
        key=$(echo "$pair" | cut -d= -f1)
        val=$(echo "$pair" | cut -d= -f2-)
        case "$key" in
            action) ACTION=$(urldecode "$val");;
            old) OLD_PW=$(urldecode "$val");;
            new) NEW_PW=$(urldecode "$val");;
        esac
    done
    IFS="$OIFS"; set +f
fi

echo "Content-Type: text/plain; charset=utf-8"
echo "Cache-Control: no-store"
echo ""

# --- 校验当前是否启用认证 ---
# 若 htpasswd 文件不存在，先创建默认 admin/admin。
# 注意：action=reset 时必须跳过这段 —— reset 的语义是"仅在文件不存在时初始化"，
# 若这里先把文件建出来，reset 分支里的 [ -f ... ] 判断永远为真，reset 就成了
# 永远走不到的死代码（旧版本的 bug）。
if [ "$ACTION" != "reset" ] && [ ! -f "$HTPASSWD_FILE" ]; then
    # 用 openssl 或 busybox 生成默认密码 "admin"
    if command -v openssl >/dev/null 2>&1; then
        HASH=$(printf '%s' 'admin' | openssl passwd -apr1 -stdin 2>/dev/null)
        [ -n "$HASH" ] || HASH=$(openssl passwd -apr1 'admin' 2>/dev/null)
    elif command -v htpasswd >/dev/null 2>&1; then
        HASH=$(htpasswd -nb "$USER" 'admin' 2>/dev/null | cut -d: -f2)
    else
        # fallback: 用 shell crypt 不可行，标记需用户手动设置
        HASH=""
    fi
    if [ -n "$HASH" ]; then
        echo "$USER:$HASH" > "$HTPASSWD_FILE"
        chmod 600 "$HTPASSWD_FILE"
    fi
fi

case "$ACTION" in
    status)
        # 查询是否启用认证
        if [ -f "$HTPASSWD_FILE" ]; then
            echo "AUTH:ENABLED"
        else
            echo "AUTH:DISABLED"
        fi
        ;;
    change)
        if [ -z "$OLD_PW" ] || [ -z "$NEW_PW" ]; then
            echo "ERROR: missing old or new password"
            exit 1
        fi
        if [ ${#NEW_PW} -lt 6 ]; then
            echo "ERROR: 新密码至少 6 位"
            exit 1
        fi
        if [ ! -f "$HTPASSWD_FILE" ]; then
            echo "ERROR: 认证文件不存在，请先开启认证"
            exit 1
        fi
        # 校验旧密码
        OLD_OK=0
        if command -v openssl >/dev/null 2>&1; then
            OLD_HASH=$(grep "^$USER:" "$HTPASSWD_FILE" | cut -d: -f2)
            if [ -n "$OLD_HASH" ]; then
                # openssl passwd 不支持直接 verify，用相同 salt 重新生成后比对。
                # 优先走 -stdin（把密码从 stdin 传），避免密码以 '-' 开头时被
                # openssl 当成选项解析；失败再退回位置参数写法。
                SALT=$(echo "$OLD_HASH" | cut -d'$' -f3)
                GEN=$(printf '%s' "$OLD_PW" | openssl passwd -apr1 -salt "$SALT" -stdin 2>/dev/null)
                [ -n "$GEN" ] || GEN=$(openssl passwd -apr1 -salt "$SALT" "$OLD_PW" 2>/dev/null)
                [ "$GEN" = "$OLD_HASH" ] && OLD_OK=1
            fi
        elif command -v htpasswd >/dev/null 2>&1; then
            htpasswd -vb "$HTPASSWD_FILE" "$USER" "$OLD_PW" >/dev/null 2>&1 && OLD_OK=1
        else
            echo "ERROR: 需要 openssl 或 htpasswd 支持"
            exit 1
        fi
        if [ "$OLD_OK" != "1" ]; then
            echo "ERROR: 旧密码不正确"
            exit 1
        fi
        # 生成新密码 hash 并写入
        if command -v openssl >/dev/null 2>&1; then
            NEW_HASH=$(printf '%s' "$NEW_PW" | openssl passwd -apr1 -stdin 2>/dev/null)
            [ -n "$NEW_HASH" ] || NEW_HASH=$(openssl passwd -apr1 "$NEW_PW" 2>/dev/null)
        elif command -v htpasswd >/dev/null 2>&1; then
            NEW_HASH=$(htpasswd -bn "$USER" "$NEW_PW" 2>/dev/null | cut -d: -f2)
        else
            echo "ERROR: no password tool"
            exit 1
        fi
        if [ -z "$NEW_HASH" ]; then
            echo "ERROR: 生成密码哈希失败"
            exit 1
        fi
        echo "$USER:$NEW_HASH" > "$HTPASSWD_FILE"
        chmod 600 "$HTPASSWD_FILE"
        echo "OK:密码修改成功"
        ;;
    reset)
        # 安全约束：reset 仅用于“首次初始化”（认证文件不存在时）。
        # 一旦认证文件已存在，说明面板已启用密码保护，匿名重置会变成接管漏洞，
        # 因此此时拒绝重置。忘记密码请通过 ADB shell 手动删除 .htpasswd 后重装。
        if [ -f "$HTPASSWD_FILE" ]; then
            echo "ERROR: 已启用认证，禁止匿名重置密码。"
            echo "如需恢复，请通过 ADB shell 执行: rm /usrdata/simcom-webui/.htpasswd"
            exit 1
        fi
        if command -v openssl >/dev/null 2>&1; then
            NEW_HASH=$(printf '%s' 'admin' | openssl passwd -apr1 -stdin 2>/dev/null)
            [ -n "$NEW_HASH" ] || NEW_HASH=$(openssl passwd -apr1 'admin' 2>/dev/null)
        elif command -v htpasswd >/dev/null 2>&1; then
            NEW_HASH=$(htpasswd -bn "$USER" 'admin' 2>/dev/null | cut -d: -f2)
        else
            echo "ERROR: no password tool"
            exit 1
        fi
        if [ -z "$NEW_HASH" ]; then
            echo "ERROR: 生成密码哈希失败"
            exit 1
        fi
        echo "$USER:$NEW_HASH" > "$HTPASSWD_FILE"
        chmod 600 "$HTPASSWD_FILE"
        echo "OK:已重置为 admin/admin"
        ;;
    *)
        echo "ERROR: unknown action. use status|change|reset"
        ;;
esac